<!-- ================= HEADER ================= -->

<!--parent div start-->
<div class="d-flex flex-nowrap w-100">
    <!--child div 1 start-->
    <div class="w-100 w-lg-75">
        <header>
  <div class="header-wrap container ">
    <div class="d-flex align-items-center justify-content-start">
  <img class="" style="width:140px;" src="images/logo.webp"
       alt="Solcrest Logo"
       loading="lazy"
       >
</div>


    <nav>
      <ul id="menu" class="menu-wrapper py-3 m-0">
        <!--<li><a href="#overview"><i class="fa-solid fa-circle-info"></i> Overview</a></li>-->
        <li><a href="#overview" class="fw-bold "><i class="fa-solid fa-circle-info"></i> Overview</a></li>
