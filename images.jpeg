          <style>
              .project-gallery {
          /*background: #f6f3ee;*/
        }
        
        /* Track */
        .gallery-track {
          display: flex;
          gap: 18px;
          overflow-x: auto;
          scroll-behavior: smooth;
          padding: 10px 5px;
        }
        
        .gallery-track::-webkit-scrollbar {
          display: none;
        }
        
        /* Item */
        .gallery-item {
          min-width: 260px;
          position: relative;
          overflow: hidden;
          border-radius: 6px;
          cursor: pointer;
        }
        
        .gallery-item img {
          width: 100%;
          height: 170px;
          object-fit: cover;
          transition: transform 0.4s ease;
        }
        
        /* Hover zoom */
