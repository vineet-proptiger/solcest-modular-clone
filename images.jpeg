        <!--</li>-->
      </ul>
      <div class="hamburger" id="hamburger"><i class="fa-solid fa-bars"></i></div>
    </nav>
  </div>
</header>
        <!-- ================= HERO ================= -->
        <section class="hero" >
              <!-- LEFT SIDE -->
              <div class="hero-left">
                <img src="images/banner.webp" class="active">
                <img src="images/banner2-sm.webp">
                <!--<img src="images/highlight.webp">-->
            
                <div class="hero-cta desktop">
                  <!--<div class="head">Booking Open</div>-->
                  <div class="body">
                    <h3 class="fw-bold fs-3 text-center mt-2">Solcrest</h3>
                    <p class="text-center fw-bold ">Off Hennur Road, Bangalore</p>
                   <div class="d-flex flex-column align-items-center justify-content-center gap-0 p-2"
                         style="background-color: #EEEEEE; border-radius: 4px;">
                    
                                                                              <p class="mb-0">Book Window Now Opens</p>
                                                        <p class="mb-0">Panoramic Wraparound Balconies</p>
                                                        <p class="mb-0">9.3-Acre High-Rise Community</p>
                                                                    
                    </div>


                   <ul>
                      <li>
              <i class="fa-solid fa-check"></i>
              East & West Vastu Oriented Homes            </li>
                      <li>
              <i class="fa-solid fa-check"></i>
              No Shared Walls With Enhanced Privacy            </li>
                      <li>
              <i class="fa-solid fa-check"></i>
              100% Corner Units & Panoramic Views            </li>
                  </ul>
                   <div class="fs-6 text-center fs-5">2,3,3.5 & 4 BHK Luxury Apartments</div>
                    <div class="price">₹1.46 Cr* Onwards</div>
            
                    <button class="orbit-btn center-btn" data-bs-toggle="modal" data-bs-target="#leadModal">
                      <span><i class="bounce-arrow fa-solid text-white fa-download"></i> Enquire Now</span>
                    </button>
                  </div>
                </div>
              </div>
        </section>
        
        <div class="d-flex flex-column justify-content-center align-items-center mobile">
        
          <!-- LEFT SIDE -->
          <div class="hero-left">
            <!--<img src="images/banner1-sm.webp" class="active">-->
            <!--<img src="images/banner2-sm.webp">-->
            <!--<img src="images/highlight.webp">-->
        
            <div class="hero-cta mobile">
              <!--<div class="head">Booking Open</div>-->
              <div class="body">
                <h3 class="fw-bold fs-1 text-center mt-2">Solcrest</h3>
                <p class="text-center fw-bold ">Off Hennur Road, Bangalore</p>
               <div class="d-flex flex-column align-items-center justify-content-center gap-0 p-2"
                     style="background-color: #EEEEEE; border-radius: 4px;">
                
                                                                  <p class="mb-0">Book Window Now Opens</p>
                                                <p class="mb-0">Panoramic Wraparound Balconies</p>
                                                <p class="mb-0">9.3-Acre High-Rise Community</p>
                                                        
                </div>


                <ul>
                               <li>
                  <i class="fa-solid fa-check"></i>
                  East & West Vastu Oriented Homes                </li>
                              <li>
                  <i class="fa-solid fa-check"></i>
                  No Shared Walls With Enhanced Privacy                </li>
                              <li>
                  <i class="fa-solid fa-check"></i>
                  100% Corner Units & Panoramic Views                </li>
                      
        
                </ul>
                 <div class="fs-6 text-center fw-bold">2,3,3.5 & 4 BHK Luxury Apartments</div>
                <div class="price">₹1.46 Cr* Onwards</div>
        
                <button class="orbit-btn center-btn" data-bs-toggle="modal" data-bs-target="#leadModal">
                  <span><i class="fa-solid fa-download"></i> Enquire Now</span>
                </button>
              </div>
            </div>
          </div>
        
          <!-- RIGHT FORM (NOT FIXED) -->
          <div class="hero-form mobile">
            <h3 class="fs-5">Get Early Entry Advantage</h3>
             <form id="globalForm"
      class="rs-lead-form needs-validation bg-white w-full  px-0 rounded-1"
      method="POST"
      action="/submit-lead"
      data-endpoint="/submit-lead"
      novalidate
      onsubmit="return window.RSLeadSubmit ? RSLeadSubmit(this,event) : true;">
     

  <!-- Hidden fields -->
  <input type="hidden" name="form_name" value="Solcrest">

  <div class="row g-3">

    <!-- Name -->
    <div class="col-12">
      <input type="text"
             class="form-control border input-p"
             name="fullname"
             placeholder="Enter full name"
             pattern="^[A-Za-z\s]+$"
             required>
      <div class="invalid-feedback">
        Please enter your name (letters only)
      </div>
    </div>

    <!-- Email -->
    <div class="col-12">
      <input type="email"
             class="form-control border input-p"
             name="email"
             placeholder="Enter email address"
             required>
      <div class="invalid-feedback">
        Please enter a valid email address
      </div>
    </div>

    <!-- Phone -->
    <div class="col-12">
      <div class="d-flex gap-2">

        <select class="form-select border d-none"
                name="country_code"
                style="max-width:25%; height:48px;"
                required>
          <option value="+91" selected>+91</option>
        </select>

        <input type="tel"
               class="form-control border input-p"
               name="phone"
               placeholder="10-digit mobile number"
               pattern="[0-9]{10}"
               maxlength="10"
               required>
      </div>
      <div class="invalid-feedback">
        Please enter a valid 10-digit mobile number
      </div>
    </div>

    <!-- Consent -->
    <div class="col-12">
      <div class="form-check mt-2">
        <input class="input-p"
               type="checkbox"
               id="gdprConsent"
               checked
               required>
        <label class="form-check-label small text-muted" for="gdprConsent">
          I agree to receive updates as per the
          <a href="/privacy-policy" target="_blank">Privacy Policy</a>.
        </label>
      </div>
    </div>

  </div>
  <!-- Status message -->
  <div class="text-center mt-3 small" data-form-message></div>
  <!-- Submit -->
  <div class="d-grid mt-3">
    <button class="btn btn-primary rounded-pill py-2 fw-semibold text-center" type="submit">
      <i class="bi bi-send me-1 text-white"></i> Schedule Visit
    </button>
  </div>
 <!-- Hidden Metadata -->
   <input type="hidden" name="form_name" value="Global Form">
  <input type="hidden" name="recaptcha_token" class="recaptcha_token">
  <input type="hidden" name="country" value="india">
  <input type="hidden" name="utm_source">
  <input type="hidden" name="utm_medium">
  <input type="hidden" name="utm_campaign">
  <input type="hidden" name="utm_term">
