      }
    },
    {
      "@type": "Question",
      "name": "What configurations are available at Bricks & Milestones Solcrest?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bricks & Milestones Solcrest offers 2, 3, 3.5 and 4 BHK residences. The project features spacious layouts designed with natural light, ventilation, balconies and comfortable living spaces."
      }
    },
    {
      "@type": "Question",
      "name": "What are the key highlights of Bricks & Milestones Solcrest?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bricks & Milestones Solcrest is spread across approximately 9.3 acres and features 6 towers with 796 residences. Key highlights include 89% open spaces, only four homes per floor, large balconies, landscaped areas, premium amenities and contemporary high-rise living."
      }
    },
    {
      "@type": "Question",
      "name": "Is Bricks & Milestones Solcrest RERA registered?",
