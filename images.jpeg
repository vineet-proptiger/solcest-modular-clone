<style>
:root{
  --blue:#0b2d52;
  --gold:#B95734;
  --green:#B95734;
  --bs-primary: #5f8d2a ; /* your brand color */
  --brand:#fa1e1e;
  --brand-600:#0F3B46;
  --light:#f7f9fb;
  --brand-purple: #B95734;
  --birla-blue: #B95734;
}

.bounce-arrow {
  /*font-size: 40px;*/
  /*color: #D4AF37; */
  display: inline-block;
  animation: ballBounce 1.2s infinite;
}

@keyframes ballBounce {
  0% {
    transform: translateY(-4px);
    animation-timing-function: ease-out;
  }
  40% {
    transform: translateY(4px);
    animation-timing-function: ease-in;
  }
  55% {
    transform: translateY(0px);
    animation-timing-function: ease-out;
  }
  70% {
    transform: translateY(2px);
    animation-timing-function: ease-in;
  }
  85% {
    transform: translateY(1px);
    animation-timing-function: ease-out;
  }
  100% {
    transform: translateY(-4px);
  }
}

.text-green{
  color: var(--gold) !important;
}

/* RESET */
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial,Helvetica,sans-serif}

/* ================= HEADER ================= */
@media (max-width:768px) {
.menu-wrapper {
        position: absolute;
        top: 60px;
        right: 0;
        background: #fff;
        flex-direction: column;
        width: 100%;
        display: none;
        box-shadow: 0 10px 30px rgba(0, 0, 0, .2);
        padding: 30px 10px 30px 20px;
    }
}
header{
  position:sticky;
  top:0;
  background:#fff;
  z-index:999;
  box-shadow:0 2px 12px rgba(0,0,0,.1);
}
.container {
    max-width: 1320px !important;
}
.header-wrap{
  /*max-width:1200px;*/
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:5px 20px;
}
.logo {
  max-width: 220px!important;
  width: 100%;
  font-size:22px;
  font-weight:bold;
  margin: 0 auto;
  color:var(--blue);
  display: flex;
  justify-content: center;
  /*filter: brightness(0) saturate(100%)*/
  /*        invert(28%)*/
  /*        sepia(87%)*/
  /*        saturate(458%)*/
  /*        hue-rotate(118deg)*/
  /*        brightness(92%)*/
  /*        contrast(92%);*/
  
}
.logo img {
    max-width:180px;
}
.logo span{color:var(--gold)}

nav ul{
  display:flex;
  gap:22px;
  list-style:none;
}
nav a{
  text-decoration:none;
  color:#333;
  font-size:14px;
}
nav a i{margin-right:6px;color:var(--blue)}

.brochure-btn a{
  position:relative;
  padding:8px 18px;
  border-radius:10px;
  background: linear-gradient(
    90deg,
    var(--brand-purple),
    var(--birla-blue),
    var(--brand-purple)
  );

  background-size: 300% 100%;
  animation: waveMix 4s ease-in-out infinite;
  color:#fff;
  overflow:hidden;
}
.brochure-btn a::before{
  content:"";
  position:absolute;
  inset:-2px;
  border:2px solid var(--button);
  border-radius:inherit;
  animation:orbit 3s linear infinite;
}

@keyframes orbit{
  0%{clip-path:polygon(0 0,100% 0,100% 6%,0 6%)}
  25%{clip-path:polygon(94% 0,100% 0,100% 100%,94% 100%)}
  50%{clip-path:polygon(0 94%,100% 94%,100% 100%,0 100%)}
  75%{clip-path:polygon(0 0,6% 0,6% 100%,0 100%)}
  100%{clip-path:polygon(0 0,100% 0,100% 6%,0 6%)}
}

/* HAMBURGER */
.hamburger{display:none;font-size:22px;cursor:pointer}

/* ================= HERO ================= */
.hero{
  display:flex;
  min-height:100vh;
  position:relative;
  
}
@media (max-width:768px) {
.hero, .hero-left{
  min-height:35vh!important;
}
  .hero {
  display:flex;
  position:relative;
  
  }
  .header-wrap {
      padding: 15px 20px;
  }
}


/* LEFT */
.hero-left{
  flex:1;
  position:relative;
  overflow:hidden;
  width:100%;
  height: 100vh;
}

.hero-left img{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  opacity:0;
  transition:opacity 1s ease;
  
}

.hero-left img.active{
  opacity:1;
}
/* LEFT CTA */
/* LEFT CTA */
.hero-cta{
  position:absolute;
  top:45%;
  left:8px;
  transform:translateY(-50%);
  /*background:#fff;*/
  width:310px;
  border-radius:0px;
  overflow:hidden;
  box-shadow:0 20px 40px rgba(0,0,0,.35);
}
.hero-cta h3 {
    color: var(--green);
    font-size: 24px;
    text-transform: uppercase;
}
@media (max-width: 991px) {
    .hero-cta {
        width: 100%!important;
        margin: 0 auto;
    }
}
.hero-cta .head {
  color: #fff;
  text-align: center;
  padding: 10px;
  font-weight: bold;

  /* Animated gradient mix */
  background: linear-gradient(
    90deg,
    var(--brand-purple),
    var(--birla-blue),
    var(--brand-purple)
  );

  background-size: 300% 100%;
  animation: waveMix 2s ease-in-out infinite;
}
@keyframes waveMix {
 0% {
    background-position: 100% 50%;
  }
  60% {
    background-position: 0% 50%;
  }
  100% {
    background-position: 100% 50%;
  }
}

.hero-cta .body {
    padding: 5px 5px 12px 5px;
    border: 2px solid #8a8787;
    width: 95%;
    margin: 0 auto;
    margin-top: 0px;
    border-radius: 20px;
    background-color: white;
}
.hero-cta ul{list-style:none;margin:12px 0; background: linear-gradient(
    90deg,
    var(--brand-purple),
    var(--birla-blue),
    var(--brand-purple)
  );

  background-size: 300% 100%;
  animation: waveMix 4s ease-in-out infinite; border-radius:5px; border: var(--button); padding: 5px;}
.hero-cta li{font-size:12px;margin-bottom:8px; border-bottom: 1px solid white; padding: 5px; color: white; text-align: center;}
.hero-cta li i{color:white; margin-right:6px}
.hero-cta li:last-child {
    border-bottom: none;
    margin-bottom:0;
}
.price{
  text-align:center;
  font-size:26px;
  color:var(--green);
  font-weight:400;
  margin:10px 0;
}
.orbit-btn, .btn-primary {
  position:relative;
  display:inline-block;
  padding:12px 26px;
  border-radius:10px!important;
  background: linear-gradient(
    90deg,
    var(--brand-purple),
    var(--birla-blue),
    var(--brand-purple)
  );

  background-size: 300% 100%;
  animation: waveMix 4s ease-in-out infinite;
  color:#fff;
  border:none;
  font-size:14px;
  cursor:pointer;
  width: auto;
  margin: 0 auto;
  /*overflow:hidden;*/
}
.orbit-btn:hover {
    color: white;
}

/* center */
.center-btn{
  display:block;
  margin:0 auto;
}

/* animated border */
.orbit-btn::before{
  content:"";
  position:absolute;
  inset:-2px;
  border-radius:inherit;
  border:2px solid var(--gold);
  animation:orbit 3s linear infinite;
  pointer-events:none;
  z-index:1;
  /*cursor: pointer;*/
}
.btn-primary::before{
  content:"";
  position:absolute;
  inset:-2px;
  border-radius:inherit;
  border:2px solid var(--gold);
  animation:orbit 3s linear infinite;
  pointer-events:none;
  z-index:1;
  /*cursor: pointer;*/
}

/* text above border */
.btn-primary span{
  position:relative;
  z-index:2;
}
.rs-lead-form .bi {
    color:white;
}
/* text above border */
.orbit-btn span{
  position:relative;
  z-index:2;
}



/* RIGHT FORM */
.hero-form{
  position: sticky!important;
  top: 40px;              /* distance from top when sticking */
  z-index: 10;
  width:100%;
  align-self:center;          /* vertical center */
  margin-right:30px;
  background:#fff;
  padding:22px;
  border-radius:0px;
  box-shadow:0 20px 40px rgba(0,0,0,.35);
  z-index:5;
  min-height: 100vh;
}

.hero-form h3{
  text-align:center;
  margin-bottom:18px;
  /* font-size:18px!important; */
}

.hero-form input{
  /*width:100%;*/
  padding:12px;
  margin-bottom:10px;
  /*border-radius:8px;*/
  border:1px solid #ccc;
}

.desktop {
      display: block;
  }
  .mobile {
      display: none;
  }



/* ================= MOBILE ================= */
@media(max-width:991px){
  nav ul{
    position:absolute;
    top:65px;
    right:0;
    background:#fff;
    flex-direction:column;
    width:220px;
    display:none;
    box-shadow:0 10px 30px rgba(0,0,0,.2);
  }
  nav ul.show{display:flex}
  .hamburger{display:block}
.nav ul li {
    display: flex;
    align-items: center;
}

  .hero{flex-direction:column}
  .hero-cta{
    position:relative;
    top:auto;
    left:auto;
    transform:none;
    margin:0px;
    width: 350px;
    display: flex;
    flex-direction: column;
    justify-content-center
  }
  .hero-form{
    width:95%;
    margin:20px;
  }
   .hero-left{
    min-height:70vh;
  }
  .hero-form {
      min-height: 30vh;
  }

  .desktop {
      display: none;
  }
  .mobile {
      display: block;
  }
  .hero-cta .body {
      margin-top: 30px;
  }
}

@media (min-width: 992px) {
  .w-lg-75 {
    width: 75% !important;
  }
  .w-lg-25 {
      width: 25% !important;
  }
}

</style>
</head>

