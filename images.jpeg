          <style>
              .amenities-section {
          background: #f4efec;
        }
        
        /* Horizontal scroll */
        .amenities-scroll {
          display: flex;
          gap: 18px;
          overflow-x: auto;
          scroll-behavior: smooth;
          padding: 10px 0px;
        }
        
        /* Hide scrollbar */
        .amenities-scroll::-webkit-scrollbar {
          display: none;
        }
        
        /* One column = 2 rows */
        .amenity-col {
          display: flex;
          flex-direction: column;
          gap: 18px;
          min-width: 260px;
        }
        
        /* Card */
        .amenity-card {
          position: relative;
          height: 180px;
          overflow: hidden;
          border-radius: 4px;
          cursor: pointer;
        }
        
        .amenity-card img {
          width: 100%;
          height: 100%;
          object-fit: cover bottom center;
          transition: transform 0.5s ease;
        }
        .amenity-card:hover img {
          transform: scale(1.08);
        }
        .amenity-card::after {
          content: "";
          position: absolute;
          inset: 0;
          background: linear-gradient(
            to top,
            rgba(0,0,0,0.65),
            rgba(0,0,0,0.15),
            rgba(0,0,0,0)
          );
           opacity: 0;
          transition: opacity 0.4s ease;
          pointer-events: none;
        }
        .amenity-card:hover::after {
          opacity: 1;
        }
        /* Label */
        .amenity-card span {
          position: absolute;
          bottom: 10px;
          left: 10px;
          background: rgba(0,0,0,0.65);
          color: #fff;
          font-size: 12px;
          font-weight: 600;
          padding: 4px 10px;
          letter-spacing: 0.5px;
           transition: all 0.35s ease;
        }
        .amenity-card:hover span {
          background: var(--green);
          transform: translateY(-4px);
        }
        /* Arrows */
        .amenity-arrow {
          position: absolute;
          top: 50%;
          transform: translateY(-50%);
          width: 40px;
          height: 40px;
          border-radius: 50%;
          background: #fff;
          border: none;
          box-shadow: 0 6px 18px rgba(0,0,0,0.25);
          z-index: 5;
        }
        
        .amenity-arrow.left { left: 0; }
        .amenity-arrow.right { right: 0; }
        
        .amenity-arrow i {
          color: #000;
        }
        .lightbox img { pointer-events: none; }
        
        
          </style>
          <script>
        function scrollAmenities(dir) {
          const scrollBox = document.getElementById('amenitiesScroll');
          const scrollAmount = 280;
          scrollBox.scrollLeft += dir * scrollAmount;
        }
        </script>
        </section>
