<style>
.custom-modal-width {
  max-width: 600px; /* ideal for 2-column form modal */
  width: 100%;
}
/* Prevent overflow */
.modal-content {
  overflow: hidden;
}
/* Left panel width control */
.promise-section {
  max-width: 100%;
}
/* Ensure columns don’t stretch */
.modal .row {
  margin: 0;
}
 .btn-close {
  /*background-color: var(--green);*/
  /*color: white;*/
  opacity: 1;
}

.promise-section {
  padding: 20px 20px;
  background: #fff;
  height: 100%;
}

.promise-title {
  color: var(--green);
  font-weight: 600;
  margin-bottom: 30px;
  font-size: 18px;
}

.promise-row {
  display: flex;
  justify-content: center;
  gap: 35px;
}

.promise-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  color: var(--green);
  font-weight: 500;
  font-size: 14px;
}

.promise-item i {
  font-size: 28px;
}

/* MOBILE */
@media (max-width: 991px) {
  .promise-row {
    flex-direction: row;
    gap: 20px;
  }

  .promise-section {
    border-top: 1px solid #eee;
  }
  .custom-modal-width {
    max-width: 95%;
  }
  .promise-title {
      display:none;
  }
}

</style>

